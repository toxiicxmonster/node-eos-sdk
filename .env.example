# Copy to .env and fill in from the Epic Developer Portal.
# .env is gitignored. The client secret is a credential, not configuration:
# it does not belong in source control, and it must never reach a renderer
# process or a shipped web bundle.

EOS_PRODUCT_ID=
EOS_SANDBOX_ID=
EOS_DEPLOYMENT_ID=
EOS_CLIENT_ID=
EOS_CLIENT_SECRET=

# 256-bit key, exactly 64 hex characters. The SDK requires one even when
# nothing uses it. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EOS_ENCRYPTION_KEY=

# Set to 1 to route the SDK log to stdout in the tests. It is talkative, and it
# usually states the real cause of a failure outright.
EOS_DEBUG=0

# Only needed by examples/steam-crossplay.js
STEAM_APP_ID=
